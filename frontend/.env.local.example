# Cloudinary credentials for scripts/upload-frames-cloudinary.mjs only.
# Copy to .env.local and fill in. Never commit .env.local.
CLOUDINARY_CLOUD_NAME=dghhdz3et
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client-side delivery. The cloud name is public; it appears in every frame URL.
VITE_CLOUDINARY_CLOUD_NAME=dghhdz3et

# Admin API base URL (backend/Api). Required for production builds (put it in .env.production);
# the site reads prices, dates and offers from it.
VITE_API_URL=
